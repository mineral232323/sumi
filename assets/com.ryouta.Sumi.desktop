[Desktop Entry]
Type=Application
Name=Sumi
GenericName=Handwritten Notes
Comment=Lightweight handwritten notebooks, pages, and PDF annotations
Exec=sumi %F
Icon=sumi-app
Terminal=false
Categories=Office;Graphics;VectorGraphics;
